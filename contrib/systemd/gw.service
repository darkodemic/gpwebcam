# systemd user unit for gw. Install with:
#   install -Dm755 gw ~/.local/bin/gw
#   install -Dm644 contrib/systemd/gw.service ~/.config/systemd/user/gw.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now gw.service
#
# gw runs as the logged-in user: the uaccess ACL lets it write to the
# v4l2loopback device, and it needs no root. It keeps the device fed with
# a placeholder picture and switches to the camera whenever one is plugged in.

[Unit]
Description=gw: GoPro as a webcam through v4l2loopback
Documentation=https://github.com/darkodemic/gw

[Service]
Type=exec
ExecStart=%h/.local/bin/gw run
Restart=on-failure
RestartSec=10s

# gw needs the loopback device, IPv4 to the camera and netlink to read
# interfaces; nothing else.
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes

[Install]
WantedBy=default.target
